# =====================================================================
# SONARA Voice Agent — Environment Variables Reference (.env.example)
# Copy this file to ".env" for local development:  cp .env.example .env
# For Vercel Production: Add these in Project Settings → Environment Variables.
# =====================================================================

# ---------------------------------------------------------------------
# 1) GROQ (REQUIRED) -> STT (Whisper Large v3 Turbo) & LLM (Llama 3.3-70B)
#    https://console.groq.com/keys
# ---------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here

# ---------------------------------------------------------------------
# 2) ELEVENLABS (REQUIRED for Primary Jessica Voice)
#    https://elevenlabs.io/app/settings/api-keys
# ---------------------------------------------------------------------
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here

# ---------------------------------------------------------------------
# 3) SARVAM AI (OPTIONAL) -> Fallback STT (saarika:v2) & TTS (bulbul:v2)
#    https://dashboard.sarvam.ai/
# ---------------------------------------------------------------------
SARVAM_API_KEY=sk_your_sarvam_api_key_here

# ---------------------------------------------------------------------
# 4) SUPABASE POSTGRESQL + PGVECTOR (OPTIONAL for Cloud Persistence & RAG)
#    PostgreSQL Connection Pooler URI (Session/Transaction mode)
# ---------------------------------------------------------------------
POSTGRES_URL=postgresql://postgres.your_project:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------
# 5) ADMIN AUTHENTICATION & SECURITY
# ---------------------------------------------------------------------
# Secret required to access bulk read operations on /api/db (get_appointments, get_customers)
ADMIN_SECRET=your_secure_admin_secret_token_here

# CORS restriction (Leave empty for request-origin matching or specify exact domain)
ALLOWED_ORIGIN=https://sonara-voice-agent.vercel.app

# ---------------------------------------------------------------------
# 6) NOTIFICATIONS — Resend (Email) & Twilio (WhatsApp)
# ---------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+17372212163
TWILIO_CONTENT_SID=HXfe5ab5f00277942d4d4200328b4d403c

# Admin Notification Recipients (where new booking alerts are sent)
ADMIN_EMAIL=admin@example.com
ADMIN_WHATSAPP=+919000000000

# ---------------------------------------------------------------------
# 7) EXOTEL TELEPHONY (PSTN / GSM Calling to Indian Phones)
# ---------------------------------------------------------------------
EXOTEL_ACCOUNT_SID=revtidigital1
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_CALLER_ID=09513886363
EXOTEL_APP_ID=1327980
