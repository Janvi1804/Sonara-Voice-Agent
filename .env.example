# =====================================================================
# SONARA Voice Agent — Environment Variables
# Copy this file to ".env" and fill in your keys:  cp .env.example .env
# NOTE: .env is gitignored and must NOT be committed.
# =====================================================================

# ---------------------------------------------------------------------
# 1) GROQ  (REQUIRED)  ->  powers BOTH STT (Whisper Large v3 Turbo)
#    and the default LLM (openai/gpt-oss-120b).
#    Get a key: https://console.groq.com/keys
# ---------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_key_here

# Optional alias — some client-side code reads VITE_API_KEY as the Groq key.
# Keep it same as GROQ_API_KEY if you use the browser Settings flow.
VITE_API_KEY=gsk_your_groq_key_here

# ---------------------------------------------------------------------
# 2) HUGGINGFACE  (OPTIONAL)  ->  only if you pick Google Gemma models
#    in Settings instead of the default Groq engine.
#    Get a token: https://huggingface.co/settings/tokens
# ---------------------------------------------------------------------
HF_TOKEN=hf_your_huggingface_token_here
VITE_HF_TOKEN=hf_your_huggingface_token_here

# ---------------------------------------------------------------------
# 3) FISH AUDIO TTS  (OPTIONAL)  ->  neural TTS voice.
#    The bundled key is out of credit (HTTP 402). Add your own OR
#    just use the browser-side Kokoro TTS instead (no key needed).
#    Get a key: https://fish.audio/app/developers
# ---------------------------------------------------------------------
FISH_AUDIO_API_KEY=sk-fish-your_fish_audio_key_here

# ---------------------------------------------------------------------
# 4) POSTGRES / pgvector  (OPTIONAL)  ->  only for RAG + long-term memory.
#    Any one of these is read (first non-empty wins). Supabase works too.
# ---------------------------------------------------------------------
POSTGRES_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# ---------------------------------------------------------------------
# 5) SERVER  (OPTIONAL)  ->  local Node server port (default 3000).
# ---------------------------------------------------------------------
PORT=3000
